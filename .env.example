# Personal ClickUp API token (Settings > Apps > API Token), starts with pk_
CLICKUP_API_TOKEN=
# Shared password for the team (optional but recommended: the token can write to ClickUp)
APP_PASSWORD=
# Set automatically when you connect a Vercel Blob store (needed for videos over 4 MB)
BLOB_READ_WRITE_TOKEN=
# Optional overrides (defaults: AdventureCraft > ADVC - What's Left? > QA)
QA_PARENT_TASK_ID=123n15he40e
QA_LIST_ID=901523125199
